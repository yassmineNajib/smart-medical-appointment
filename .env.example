# Public frontend configuration
# VITE_ variables are bundled into the browser application. Do not put passwords,
# API keys, or private tokens in this file or in any VITE_ variable.

VITE_SEARCH_SLOTS_URL=https://your-automation-host.example/webhook/search-slots
VITE_CONFIRM_APPOINTMENT_URL=https://your-automation-host.example/webhook/confirm-appointment
VITE_TEXT_APPOINTMENT_URL=https://your-automation-host.example/webhook/text-appointment
VITE_CONFIRM_PRESENCE_URL=https://your-automation-host.example/webhook/confirm-presence
VITE_CANCEL_APPOINTMENT_URL=https://your-automation-host.example/webhook/cancel-appointment
VITE_API_TIMEOUT_MS=15000
VITE_TEXT_APPOINTMENT_TIMEOUT_MS=30000
